{
  "rule_files": [
    {"path": "local.rules", "enabled": true}
  ],
  "disabled_sids": [],
  "variables": {
    "HOME_NET": "any",
    "EXTERNAL_NET": "any",
    "HTTP_PORTS": "[80,8000,8080,8888]"
  },
  "flow_timeout": {"tcp": 300, "udp": 60},
  "skip_unknown": false,
  "max_payload": null,
  "alert": {
    "severity_map": {"1": "CRITICAL", "2": "HIGH", "3": "MEDIUM", "4": "LOW"},
    "min_severity": "LOW",
    "suppress": [],
    "aggregation": {"enabled": true, "window": 60}
  }
}
