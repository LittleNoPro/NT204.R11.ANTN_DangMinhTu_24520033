# T12 — flags (exact, +, *, !, 0) và dsize (>, <>)
alert tcp any any -> any any (msg:"T12 flags S (chỉ SYN)"; flags:S; sid:3120001; rev:1;)
alert tcp any any -> any any (msg:"T12 flags SA (đúng SYN+ACK)"; flags:SA; sid:3120002; rev:1;)
alert tcp any any -> any any (msg:"T12 flags S+ (có SYN)"; flags:S+; sid:3120003; rev:1;)
alert tcp any any -> any any (msg:"T12 flags *FR (FIN hoặc RST)"; flags:*FR; sid:3120004; rev:1;)
alert tcp any any -> any any (msg:"T12 flags !A (không có ACK)"; flags:!A; sid:3120005; rev:1;)
alert tcp any any -> any any (msg:"T12 flags 0 (NULL scan)"; flags:0; sid:3120006; rev:1;)
alert tcp any any -> any any (msg:"T12 flags FPU (XMAS)"; flags:FPU; sid:3120007; rev:1;)
alert tcp any any -> any any (msg:"T12 dsize > 100"; dsize:>100; sid:3120008; rev:1;)
alert tcp any any -> any any (msg:"T12 dsize 5..20"; dsize:5<>20; sid:3120009; rev:1;)
alert tcp any any -> any any (msg:"T12 PA và dsize > 100"; flags:PA; dsize:>100; sid:3120010; rev:1;)
