# T03 — rule đúng cú pháp nhưng ngoài phạm vi → unsupported, không crash
alert tcp any any -> any 80 (msg:"pcre"; pcre:"/admin/i"; sid:3030001;)
alert tcp any any -> any 80 (msg:"http_uri + byte_test"; content:"admin"; http_uri; byte_test:4,>,1000,0; sid:3030002;)
